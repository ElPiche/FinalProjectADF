{
  "kbConfig": {
    "id": "8fbb07a4-favf-46ed-9eae-b8d1289c570c",
    "description": "Geographic Traffic Pattern Analysis - Monitors traffic by region",
    "queryElastic": {
      "query": "FROM .ds-kibana_sample_data_logs-* | WHERE @timestamp >= $from AND @timestamp < $to | EVAL es_timestamp = DATE_TRUNC(1 hour, @timestamp) | STATS cn_traffic = COUNT(*) WHERE geo.src == 'CN' BY es_timestamp | SORT es_timestamp"
    },
    "scheduling": {
      "trainingConfig": {
        "from": "2025-10-01T00:00:00Z",
        "to": "2025-10-09T23:59:59Z",
        "mode": "batch"
      },
      "detectionConfig": {
        "frequency": "*/15 * * * *",
        "window": "* 1 * * *",
        "start": "2025-10-10T00:00:00Z",
        "mode": "streaming"
      }
    },
    "daAlgParameters": {
      "zscore": [
        { "threshold": 3, "observedValue": "cnTraffic" },
        { "threshold": 4, "observedValue": "avgBytes" }
      ],
      "arma": [
        { "p": 2, "d": 1, "q": 2, "observedValue": "cnTraffic" },
        { "p": 3, "d": 1, "q": 3, "observedValue": "avgBytes" }
      ],
      "kmeans": [
        { "nClusters": 3, "observedValue": "cnTraffic" },
        { "nClusters": 4, "observedValue": "avgBytes" }
      ],
      "iforest": [
        { "nEstimators": 100, "contamination": 0.05, "randomState": 42, "observedValue": "cnTraffic" },
        { "nEstimators": 150, "contamination": 0.1, "randomState": 42, "observedValue": "avgBytes" }
      ]
    }
  }
}
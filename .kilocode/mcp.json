{
  "mcpServers": {
    "elasticsearch": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ES_URL",
        "mcp/elasticsearch",
        "stdio"
      ],
      "env": {
        "ES_URL": "http://host.docker.internal:9200"
      },
      "alwaysAllow": [
        "esql",
        "list_indices",
        "get_mappings",
        "search"
      ]
    },
    "KB-MCP": {
      "command": "python",
      "args": [
        "c:/Users/Elinzar/Documents/Tecnologo/Projecto2025/FinalProjectADF/MCP/KB-MCP/server.py"
      ],
      "env": {},
      "alwaysAllow": [
        "describe_mcp_server",
        "list_available_algorithms",
        "create_da_config",
        "modify_kb_config",
        "list_kb_configurations"
      ]
    }
  }
}
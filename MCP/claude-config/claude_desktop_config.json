{
  "mcpServers": {
    "elasticsearch": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ES_URL",
        "mcp/elasticsearch",
        "stdio"
      ],
      "env": {
        "ES_URL": "http://host.docker.internal:9200"
      }
    },
    "kb-mcp": {
      "command": "python",
      "args": [
        "../KB-MCP/kb-mcp.py"
      ],
      "env": {},
      "alwaysAllow": [
        "create_da_config",
        "elasticsearch_sql",
        "list_available_algorithms",
        "modify_kb_config",
        "list_kb_configurations",
        "describe_mcp_server"
      ]
    }
  }
}
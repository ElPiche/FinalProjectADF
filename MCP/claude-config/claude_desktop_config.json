{
  "mcpServers": {
    "elasticsearch": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ES_URL",
        "mcp/elasticsearch",
        "stdio"
      ],
      "env": {
        "ES_URL": "http://host.docker.internal:9200"
      }
    },
    "KB-MCP": {
      "command": "python",
      "args": [
        "../KB-MCP/kb-mcp.py" //use your relative path to kb-mcp.py in claude_desktop_config.json
      ],
      "env": {}
    }
  }
}